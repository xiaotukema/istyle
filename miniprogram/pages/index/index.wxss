.page {
  min-height: 100vh;
  overflow: hidden;
}

.camera {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
}

.camera-placeholder {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  padding: 48rpx;
  color: #fff;
  background:
    radial-gradient(circle at 30% 22%, rgba(107, 213, 208, 0.26), transparent 34%),
    radial-gradient(circle at 78% 72%, rgba(231, 166, 173, 0.2), transparent 36%),
    #080a0d;
}

.placeholder-title {
  font-size: 44rpx;
  font-weight: 900;
}

.placeholder-subtitle {
  color: rgba(255, 255, 255, 0.66);
  font-size: 26rpx;
}

.panel {
  position: fixed;
  top: 28rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 16rpx;
  background: rgba(10, 12, 15, 0.66);
  backdrop-filter: blur(18px);
}

.title {
  font-size: 34rpx;
  font-weight: 800;
}

.quota,
.analysis {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
}

.tryon {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 190rpx;
  bottom: 260rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: rgba(10, 12, 15, 0.72);
}

.tryon image {
  width: 100%;
  height: calc(100% - 112rpx);
}

.caption {
  padding: 16rpx 20rpx 4rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.reason {
  padding: 0 20rpx 16rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
}

.loading {
  position: fixed;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: rgba(10, 12, 15, 0.72);
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #6bd5d0;
  border-radius: 999rpx;
}

.stylebar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 150rpx;
  white-space: nowrap;
}

.style {
  display: inline-flex;
  margin-right: 12rpx;
  min-width: 180rpx;
  color: rgba(255, 255, 255, 0.68);
  background: rgba(10, 12, 15, 0.68);
}

.style.active {
  color: #111313;
  background: linear-gradient(135deg, #6bd5d0, #d9b36a 56%, #e7a6ad);
}

.dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 36rpx;
  display: flex;
  gap: 16rpx;
}

.dock button {
  flex: 1;
  height: 88rpx;
  font-weight: 800;
}

.primary {
  color: #111313;
  background: linear-gradient(135deg, #6bd5d0, #d9b36a 56%, #e7a6ad);
}

.secondary {
  color: #fff;
  background: rgba(10, 12, 15, 0.72);
}

.disabled {
  opacity: 0.42;
}
