.page {
  min-height: 100vh;
  overflow: hidden;
  background: #050608;
}

.camera {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  transition: all 220ms ease;
  z-index: 1;
}

.camera-pip {
  left: auto;
  top: 24rpx;
  right: 24rpx;
  width: 176rpx;
  height: 236rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.36);
  z-index: 6;
}

.panel {
  position: fixed;
  top: 28rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 16rpx;
  background: rgba(10, 12, 15, 0.66);
  backdrop-filter: blur(18px);
  z-index: 4;
}

.panel-compact {
  top: 24rpx;
  left: 24rpx;
  right: 220rpx;
  padding: 16rpx 18rpx;
  background: rgba(10, 12, 15, 0.58);
}

.title {
  font-size: 34rpx;
  font-weight: 800;
}

.quota,
.analysis {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
}

.panel-compact .title {
  font-size: 28rpx;
}

.panel-compact .analysis {
  display: none;
}

.tryon,
.tryon-error {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 226rpx;
  overflow: hidden;
  border-radius: 0;
  background: #050608;
  z-index: 3;
}

.tryon image {
  width: 100%;
  height: 100%;
}

.tryon::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 190rpx;
  background: linear-gradient(180deg, rgba(5, 6, 8, 0), rgba(5, 6, 8, 0.84));
}

.tryon-error {
  left: 32rpx;
  right: 32rpx;
  top: 210rpx;
  bottom: auto;
  padding: 24rpx;
  border-radius: 20rpx;
  z-index: 4;
}

.tryon-error .caption,
.tryon-error .reason {
  position: static;
  left: auto;
  right: auto;
  bottom: auto;
}

.caption {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 72rpx;
  padding: 16rpx 20rpx 4rpx;
  font-size: 30rpx;
  font-weight: 800;
  z-index: 1;
}

.reason {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 0 20rpx 16rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
  z-index: 1;
}

.loading {
  position: fixed;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: rgba(10, 12, 15, 0.72);
  z-index: 7;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #6bd5d0;
  border-radius: 999rpx;
}

.stylebar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 150rpx;
  white-space: nowrap;
  z-index: 5;
}

.style {
  display: inline-flex;
  margin-right: 12rpx;
  min-width: 180rpx;
  color: rgba(255, 255, 255, 0.68);
  background: rgba(10, 12, 15, 0.68);
}

.style.active {
  color: #111313;
  background: linear-gradient(135deg, #6bd5d0, #d9b36a 56%, #e7a6ad);
}

.dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 36rpx;
  display: flex;
  gap: 16rpx;
  z-index: 5;
}

.dock button {
  flex: 1;
  height: 88rpx;
  font-weight: 800;
}

.primary {
  color: #111313;
  background: linear-gradient(135deg, #6bd5d0, #d9b36a 56%, #e7a6ad);
}

.secondary {
  color: #fff;
  background: rgba(10, 12, 15, 0.72);
}

.disabled {
  opacity: 0.42;
}
