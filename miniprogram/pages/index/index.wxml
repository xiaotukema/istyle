<view class="page">
  <camera
    class="camera {{currentImage ? 'camera-pip' : ''}}"
    device-position="front"
    flash="off"
    frame-size="small"
    bindinitdone="onCameraReady"
    binderror="onCameraError"
  ></camera>

  <view class="snap-flash {{snapFlash ? 'show' : ''}}"></view>

  <view class="panel {{currentImage ? 'panel-compact' : ''}}">
    <view class="title">实时发型试戴</view>
    <view class="quota">今日剩余 {{quota.remaining}} / {{quota.limit}}</view>
    <view class="analysis" wx:if="{{analysis.summary}}">
      <view>{{analysis.summary}}</view>
    </view>
    <view class="gesture-hint" wx:if="{{gestureHint}}">{{gestureHint}}</view>
  </view>

  <view class="tryon" wx:if="{{currentImage}}">
    <image src="{{currentImage}}" mode="aspectFill"></image>
    <view class="caption">{{currentStyle.rank}}. {{currentStyle.label}}</view>
    <view class="reason">{{currentStyle.reason}}</view>
  </view>
  <view class="tryon-error" wx:elif="{{tryonError}}">
    <view class="caption">高清试戴图生成失败</view>
    <view class="reason">{{tryonError}}</view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="spinner"></view>
    <view>{{loadingText}}</view>
  </view>

  <scroll-view class="stylebar" scroll-x wx:if="{{styles.length}}">
    <button
      wx:for="{{styles}}"
      wx:key="id"
      class="style {{index === currentIndex ? 'active' : ''}} {{!item.tryonImage && !item.tryonError ? 'pending' : ''}}"
      bindtap="selectStyle"
      data-index="{{index}}"
    >{{item.rank}}. {{item.label}}{{item.tryonImage ? ' ✓' : ''}}{{!item.tryonImage && !item.tryonError ? ' · 生成中' : ''}}</button>
  </scroll-view>

  <view class="dock">
    <button class="primary" bindtap="startRecommend" wx:if="{{!styles.length}}" loading="{{loading}}">开始 AI 推荐</button>
    <button class="primary {{quota.remaining <= 0 || !remainingCount ? 'disabled' : ''}}" bindtap="recommendMore" wx:if="{{styles.length}}" loading="{{loading}}">{{remainingCount ? '推荐更多' : '今日已达上限'}}</button>
    <button class="secondary" bindtap="resetQuota" wx:if="{{quota.remaining <= 0}}">重置测试次数</button>
    <button class="secondary" bindtap="saveImage" wx:if="{{currentImage}}">保存截图</button>
  </view>
</view>
