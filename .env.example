PORT=8000

# Image and analysis providers
IMAGE_PROVIDER=seedream
ANALYSIS_PROVIDER=ark
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
ANALYSIS_MODEL=doubao-seed-2-0-lite-260428
ANALYSIS_SYNC_TIMEOUT_MS=22000
ANALYSIS_JOB_TIMEOUT_MS=45000

# Optional providers
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
LIBLIB_ACCESS_KEY=
LIBLIB_SECRET_KEY=

# WeChat Mini Program login
WX_APPID=
WX_APP_SECRET=

# Cost control
DAILY_HAIR_LIMIT=11
HAIR_TRYON_LIMIT=11
HAIR_VARIANT_CONCURRENCY=1
ENABLE_DEV_QUOTA_RESET=false

# Optional persistent quota store for CloudBase Run / production.
# If omitted, the server falls back to in-memory quota for local development.
MYSQL_ADDRESS=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=istyle
